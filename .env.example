# Frontend
VITE_TRIPPILOT_API_URL=http://localhost:8000

# Backend
APP_ENV=development
TRAVEL_DATA_MODE=demo
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Model gateway (optional in demo mode)
OPENROUTER_API_KEY=
TRIP_AGENT_MODEL=openai/gpt-4.1-mini

# Supabase / PostgreSQL (service key is backend-only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live providers (not required in demo mode)
PLACES_PROVIDER=demo
ROUTES_PROVIDER=demo
ROUTES_TRAVEL_MODE=DRIVE
ROUTES_ROUTING_PREFERENCE=TRAFFIC_UNAWARE
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trippilot
