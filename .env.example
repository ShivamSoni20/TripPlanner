# Frontend
VITE_TRIPPILOT_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend
APP_ENV=development
TRAVEL_DATA_MODE=demo
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Model gateway (optional in demo mode)
OPENROUTER_API_KEY=
TRIP_AGENT_MODEL=openai/gpt-4.1-mini

# Supabase / PostgreSQL (service key is reserved for trusted administration;
# normal trip CRUD always uses the user's JWT and RLS)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live providers (not required in demo mode)
PLACES_PROVIDER=demo
ROUTES_PROVIDER=demo
ROUTES_TRAVEL_MODE=DRIVE
ROUTES_ROUTING_PREFERENCE=TRAFFIC_UNAWARE
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
WEATHER_PROVIDER=demo
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
FLIGHTS_PROVIDER=demo
AMADEUS_ENV=test
HOTELS_PROVIDER=demo
BOOKING_ENV=sandbox
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_BOOKER_COUNTRY=in

# Browser-only key. Restrict to Maps JavaScript API and approved HTTP referrers.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=trippilot
FLIGHTS_PROVIDER=serpapi
SERPAPI_API_KEY=your_serpapi_api_key_here
